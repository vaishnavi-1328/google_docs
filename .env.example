# Copy to .env and fill in. Never commit the real .env.

# Postgres
POSTGRES_USER=docs
POSTGRES_PASSWORD=docs
POSTGRES_DB=docs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# JWT signing secret — must be long and random in prod.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
# Session cookie TTL (seconds)
SESSION_TTL=604800
# Allowed origins for CORS and WS origin check
ALLOWED_ORIGINS=http://localhost:5173
# Where image/attachment uploads are stored on disk (tenant-scoped subdirs).
UPLOAD_ROOT=backend/uploads

# Frontend
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000
